# ClickHouse users (generate random passwords)
AGENT_READER_PASS=     # agent_reader — read-only для security_logs.* и system.*
AGENT_WRITER_PASS=     # agent_writer — INSERT на proposals и memory
AGENT_PROMOTER_PASS=   # agent_promoter — INSERT на alert_rules + CREATE VIEW
VECTOR_PASS=           # vector — INSERT на audit_events, assets
OTEL_PASS=             # otel — INSERT на agent_tool_calls и др.
GRAFANA_CH_PASS=       # grafana — SELECT на security_logs.* и litellm.*

# --- LiteLLM Proxy ---
# LITELLM_API_KEY — master key прокси (admin). В контейнер передаётся как
# LITELLM_MASTER_KEY (docker-compose.yml). Без Postgres virtual keys не работают,
# поэтому agent-observer ходит под тем же master key.
LITELLM_API_KEY=sk-...
LITELLM_AGENT_KEY=sk-...
AGENT_MODEL=p/deepseek-v4-flash   # модель Rule-Engine через прокси (проверена; glm отдаёт контент только в reasoning_content)

# --- Ollama ---
# Для локального запуска Ollama (стандартный порт 11434).
# На тестовом стенде значение переопределяется в .env (не коммитится).
OLLAMA_API_BASE=http://127.0.0.1:11434

# --- PROXYAPI (OpenAI-compatible) ---
OAI_PROVIDER_1_API_BASE=https://api.prov_1.ru/v1
OAI_PROVIDER_1_API_KEY=sk-...

# --- AITUNNEL (OpenAI-compatible) ---
OAI_PROVIDER_2_API_BASE=https://api.prov_2.ru/v1
OAI_PROVIDER_2_API_KEY=sk-...

# --- Claude (опционально — раскомментировать при подключении) ---
# ANTHROPIC_API_BASE=https://api.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Grafana admin
GF_ADMIN_PASS=change_me

# ClickHouse default
CLICKHOUSE_DEFAULT_PASS=